{
  "name": "okf-token-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OKF-Token Forge: a zero-LLM OKF v0.2 codebase map for DSH, Antigravity, and other harnesses.",
  "license": "MIT",
  "bin": {
    "okf-token-forge": "./bin/okf-token-forge.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./compile": "./lib/compile.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "bin/",
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
